# mksh

# Source the user's .mkshrc or $ENV file that mksh would source without mc's intervention.
if [ -n "$MC_ENV_SAVE" ]; then
    ENV="$MC_ENV_SAVE"
    unset MC_ENV_SAVE

    # In the shell, $ENV is documented to undergo parameter expansion, command substitution and
    # arithmetic expansion before resulting in a filename. But this doesn't work in mksh.
    # We don't support this either.
    if [ -f "$ENV" ]; then
        . "$ENV"
    fi
else
    unset ENV MC_ENV_SAVE
    if [ -f ~/.mkshrc ]; then
        . ~/.mkshrc
    fi
fi

# Handle command termination.
mc_precmd ()
{
    pwd >&$MC_PWD_PIPE
    kill -STOP $$
}
MC_PRECMD=mc_precmd
PS1='$($MC_PRECMD)'"$PS1"
