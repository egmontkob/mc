# fish doesn't read a .fishrc file, but we keep a consistent naming here across shells.

# Report the command line buffer on ESC _.
bind \e_ "begin; commandline -C; commandline; printf '\000'; end >&$MC_COMMAND_PIPE"

# Handle command termination.
if not functions -q fish_prompt_mc
    functions -e fish_right_prompt
    functions -c fish_prompt fish_prompt_mc
end
function fish_prompt
    echo "$PWD" >&$MC_PWD_PIPE
    kill -STOP $fish_pid
    fish_prompt_mc
end

# Set up whatever for Kitty # FIXME what is this really?
set --global __mc_kitty_keyboard 1

# Remove banner.
set fish_greeting
