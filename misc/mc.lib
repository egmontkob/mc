[External editor or viewer parameters]
vi=+%lineno %filename
vim=+%lineno %filename
view=+%lineno %filename
emacs=+%lineno %filename
nano=+%lineno %filename
joe=+%lineno %filename
more=+%lineno %filename
less=+%lineno %filename
mcedit=%filename:%lineno

[Special dirs]
list=/afs;/coda;/:;/...;/net

[terminal:console]
insert=\\e[2~
f1=\\e[[A
f2=\\e[[B
f3=\\e[[C
f4=\\e[[D
f5=\\e[[E
f6=\\e[17~
f7=\\e[18~
f8=\\e[19~
f9=\\e[20~
f10=\\e[21~
f11=\\e[23~
f12=\\e[24~
shift-f1=\\e[25~
shift-f2=\\e[26~
shift-f3=\\e[28~
shift-f4=\\e[29~
shift-f5=\\e[31~
shift-f6=\\e[32~
shift-f7=\\e[33~
shift-f8=\\e[34~
# shift-f9 .. shift-f12: see https://bugs.debian.org/698885
left=\\e[D;\\eOt
right=\\e[C;\\eOv
up=\\e[A;\\eOx
down=\\e[B;\\eOr
home=\\e[1~;\\eOw
end=\\e[4~;\\eOq
pgup=\\e[5~;\\eOy
pgdn=\\e[6~;\\eOs
insert=\\e[2~;\\eOp
delete=\\e[3~;\\eOn
kpmiddle=\\e[G;\\eOu
kpslash=\\eOQ
kpasterisk=\\eOR
kpminus=\\eOS
kpplus=\\eOl
kpenter=\\eOM

[terminal:linux]
copy=console

[terminal:vt102]
copy=linux

[terminal:xterm]
kpslash=\\eOo
kpasterisk=\\eOj
kpminus=\\eOm
kpplus=\\eOk
kpenter=\\eOM
bs=^?

[terminal:alacritty]
copy=xterm

[terminal:gnome]
copy=xterm

[terminal:rxvt]
copy=xterm
# Shift+F1 / Shift+F2 generate the same as F11 / F12 (\e[23~ / \e[24~).
# Prefer to interpret them as Shift+F1 / Shift+F2.
# Actually I have no information whether it's true for old rxvt, but it's
# definitely the case with rxvt-unicode. Assume it's the same for old rxvt.
# Shift_F1 .. Shift+F10 are defined as kf11 .. kf20 in terminfo, rather than
# kf13 .. kf22 as with most terminals, so we need to override to fix them.
shift-f1=\\e[23~
shift-f2=\\e[24~
shift-f3=\\e[25~
shift-f4=\\e[26~
shift-f5=\\e[28~
shift-f6=\\e[29~
shift-f7=\\e[31~
shift-f8=\\e[32~
shift-f9=\\e[33~
shift-f10=\\e[34~
shift-f11=\\e[23$
shift-f12=\\e[24$
ctrl-f1=\\e[11^
ctrl-f2=\\e[12^
ctrl-f3=\\e[13^
ctrl-f4=\\e[14^
ctrl-f5=\\e[15^
ctrl-f6=\\e[17^
ctrl-f7=\\e[18^
ctrl-f8=\\e[19^
ctrl-f9=\\e[20^
ctrl-f10=\\e[21^
ctrl-f11=\\e[23^
ctrl-f11=\\e[24^

[terminal:rxvt-unicode]
copy=rxvt

[terminal:rxvt-unicode-256color]
copy=rxvt

[terminal:putty]
# Same story as with rxvt, except that Shift+F11 / Shift+F12 generate the same
# as their shiftless counterpart, so they won't be recognized.
copy=rxvt

[terminal:putty-256color]
copy=rxvt

[terminal:xterm-new]
copy=xterm

[terminal:xterm-clear]
copy=xterm

[terminal:xterm-color]
copy=xterm

[terminal:xterm-256color]
copy=xterm

[terminal:xterm-direct]
copy=xterm

[terminal:xterm-direct16]
copy=xterm

[terminal:xterm-direct256]
copy=xterm

[terminal:screen]
copy=xterm

[terminal:screen-256color]
copy=xterm

[terminal:tmux]
copy=xterm

[terminal:tmux-256color]
copy=xterm

[terminal:ibmpc3]
shift-f1=\\e[Y
shift-f2=\\e[Z
shift-f3=\\e[a
shift-f4=\\e[b
shift-f5=\\e[c
shift-f6=\\e[d
shift-f7=\\e[e
shift-f8=\\e[f
shift-f9=\\e[g
shift-f10=\\e[h
bs=^h
end=\\e[F
kpplus=\\e[+
kpminus=\\e[-
kpasterisk=\\e[*

[terminal:cons25]
shift-f1=\\e[Y
shift-f2=\\e[Z
shift-f3=\\e[a
shift-f4=\\e[b
shift-f5=\\e[c
shift-f6=\\e[d
shift-f7=\\e[e
shift-f8=\\e[f
shift-f9=\\e[g
shift-f10=\\e[h

[terminal:xterm-kitty]
copy=xterm
