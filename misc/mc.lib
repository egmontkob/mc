[External editor or viewer parameters]
vi=+%lineno %filename
vim=+%lineno %filename
view=+%lineno %filename
emacs=+%lineno %filename
nano=+%lineno %filename
joe=+%lineno %filename
more=+%lineno %filename
less=+%lineno %filename
mcedit=%filename:%lineno

[Special dirs]
list=/afs;/coda;/:;/...;/net

[terminal:console]
insert=\\e[2~
f1=\\e[[A
f2=\\e[[B
f3=\\e[[C
f4=\\e[[D
f5=\\e[[E
f6=\\e[17~
f7=\\e[18~
f8=\\e[19~
f9=\\e[20~
f10=\\e[21~
f11=\\e[23~
f12=\\e[24~
shift-f1=\\e[25~
shift-f2=\\e[26~
shift-f3=\\e[28~
shift-f4=\\e[29~
shift-f5=\\e[31~
shift-f6=\\e[32~
shift-f7=\\e[33~
shift-f8=\\e[34~
# shift-f9 .. shift-f12: see https://bugs.debian.org/698885
kpleft=\\eOt
kpright=\\eOv
kpup=\\eOx
kpdown=\\eOr
kphome=\\eOw
kpend=\\eOq
kpnpage=\\eOs
kpppage=\\eOy
kpplus=\\eOl
kpminus=\\eOS
kpasterisk=\\eOR
kpinsert=\\eOp
kpdelete=\\eOn
kpenter=\\eOM
kpslash=\\eOQ
kpnumlock=\\eOP

[terminal:linux]
copy=console

[terminal:vt102]
copy=linux

[terminal:xterm]
insert=\\e[2~
f1=\\e[11~;\\e[OP
f2=\\e[12~;\\e[OQ
f3=\\e[13~;\\e[OR
f4=\\e[14~;\\e[OS
f5=\\e[15~
f6=\\e[17~
f7=\\e[18~
f8=\\e[19~
f9=\\e[20~
f10=\\e[21~
f11=\\e[23~
f12=\\e[24~
shift-f1=\\eO2P;\\eO1\;2P;\\e[1\;2P
shift-f2=\\eO2Q;\\eO1\;2Q;\\e[1\;2Q
shift-f3=\\e[25~;\\eO2R;\\eO1\;2R;\\e[1\;2R
shift-f4=\\e[26~;\\eO2S;\\eO1\;2S;\\e[1\;2S
shift-f5=\\e[28~;\\e[15\;2~
shift-f6=\\e[29~;\\e[17\;2~
shift-f7=\\e[31~;\\e[18\;2~
shift-f8=\\e[32~;\\e[19\;2~
shift-f9=\\e[33~;\\e[20\;2~
shift-f10=\\e[34~;\\e[21\;2~
shift-f11=\\e[23\;2~
shift-f12=\\e[24\;2~
kpleft=\\eOt
kpright=\\eOv
kpup=\\eOx
kpdown=\\eOr
kphome=\\eOw
kpend=\\eOq
kpnpage=\\eOs
kpppage=\\eOy
kpplus=\\eOk
kpminus=\\eOm
kpasterisk=\\eOj
delete=\\e[3~
bs=^?
home=\\e[1~;\\e[7~;\\eOH;\\e[H
end=\\eOF;\\e[F;\\e[4~;\\e[8~
pgdn=\\e[6~
pgup=\\e[5~

# Arrows for both keypad modes (application and normal).
up=\\e[A;\\eOA
down=\\e[B;\\eOB
right=\\e[C;\\eOC
left=\\e[D;\\eOD

[terminal:alacritty]
copy=xterm

[terminal:gnome]
copy=xterm

[terminal:rxvt]
copy=xterm

[terminal:xterm-new]
copy=xterm

[terminal:xterm-clear]
copy=xterm

[terminal:xterm-color]
copy=xterm

[terminal:xterm-256color]
copy=xterm

[terminal:xterm-direct]
copy=xterm

[terminal:xterm-direct16]
copy=xterm

[terminal:xterm-direct256]
copy=xterm

[terminal:screen]
copy=xterm

[terminal:screen-256color]
copy=xterm

[terminal:tmux]
copy=xterm

[terminal:tmux-256color]
copy=xterm

[terminal:ibmpc3]
shift-f1=\\e[Y
shift-f2=\\e[Z
shift-f3=\\e[a
shift-f4=\\e[b
shift-f5=\\e[c
shift-f6=\\e[d
shift-f7=\\e[e
shift-f8=\\e[f
shift-f9=\\e[g
shift-f10=\\e[h
bs=^h
end=\\e[F
kpplus=\\e[+
kpminus=\\e[-
kpasterisk=\\e[*

[terminal:cons25]
shift-f1=\\e[Y
shift-f2=\\e[Z
shift-f3=\\e[a
shift-f4=\\e[b
shift-f5=\\e[c
shift-f6=\\e[d
shift-f7=\\e[e
shift-f8=\\e[f
shift-f9=\\e[g
shift-f10=\\e[h

[terminal:st]
shift-right=\\e[1\;2C
shift-left=\\e[1\;2D
shift-up=\\e[1\;2A
shift-down=\\e[1\;2B
alt-shift-right=\\e[1\;4C
alt-shift-left=\\e[1\;4D
alt-shift-up=\\e[1\;4A
alt-shift-down=\\e[1\;4B

[terminal:st-256color]
copy=st

[terminal:st-git-256color]
copy=st

[terminal:xterm-kitty]
copy=xterm
