# This file lets mc learn the meaning of the incoming escape sequences.
#
# Keys must not repeat within a section. You can define multiple escape
# sequences for a key, separated by spaces.
#
# The following notation is available:
#
#   char (byte)  ~  notation in this file
#
#          0x01  ~  ^A
#          ....     ..
#          0x1A  ~  ^Z
#          0x1B  ~  ^[ or \e or \E
#          0x1C  ~  ^\
#          0x1D  ~  ^]
#          0x1E  ~  ^^
#          0x1F  ~  ^_
#          0x7F  ~  ^?
#
#             \  ~  \\
#             ^  ~  \^
#         space  ~  \s
#
# A trailing ^ character of an escape sequence can be left unbackslashed,
# useful for denoting sequences like urxvt's ctrl-f1: \e[11^
#
# To find out the sequence generated by your terminal, launch the command
#
#   tput smkx; cat
#
# and press a special key. You should see a sequence beginning with ^[ which
# represents the escape character. Copy-paste the result to this file.
#
# You may replace the leading ^[ with \e or \E but you don't have to.
#
# If you don't get such escape sequences, this command could help:
#
#   stty echoctl
#
# In order to catch what backspace or ctrl-backspace sends, try this:
#
#   tput smkx; showkey -a
#
# Once done with either "cat" or "showkey -a", reset the terminal's defaults:
#
#   tput rmkx

[console]
insert     = \e[2~
f1         = \e[[A
f2         = \e[[B
f3         = \e[[C
f4         = \e[[D
f5         = \e[[E
f6         = \e[17~
f7         = \e[18~
f8         = \e[19~
f9         = \e[20~
f10        = \e[21~
f11        = \e[23~
f12        = \e[24~
shift-f1   = \e[25~
shift-f2   = \e[26~
shift-f3   = \e[28~
shift-f4   = \e[29~
shift-f5   = \e[31~
shift-f6   = \e[32~
shift-f7   = \e[33~
shift-f8   = \e[34~
# shift-f9 .. shift-f12: see https://bugs.debian.org/698885
left       = \e[D  \eOt
right      = \e[C  \eOv
up         = \e[A  \eOx
down       = \e[B  \eOr
home       = \e[1~ \eOw
end        = \e[4~ \eOq
pgup       = \e[5~ \eOy
pgdn       = \e[6~ \eOs
insert     = \e[2~ \eOp
delete     = \e[3~ \eOn
kpmiddle   = \e[G  \eOu
kpslash    = \eOQ
kpasterisk = \eOR
kpminus    = \eOS
kpplus     = \eOl
kpenter    = \eOM

[linux]
copy = console

[vt102]
copy=linux

[xterm]
insert     = \e[2~
f1         = \e[11~ \e[OP
f2         = \e[12~ \e[OQ
f3         = \e[13~ \e[OR
f4         = \e[14~ \e[OS
f5         = \e[15~
f6         = \e[17~
f7         = \e[18~
f8         = \e[19~
f9         = \e[20~
f10        = \e[21~
f11        = \e[23~
f12        = \e[24~
shift-f1   = \eO2P \eO1;2P \e[1;2P
shift-f2   = \eO2Q \eO1;2Q \e[1;2Q
shift-f3   = \e[25~ \eO2R \eO1;2R \e[1;2R
shift-f4   = \e[26~ \eO2S \eO1;2S \e[1;2S
shift-f5   = \e[28~ \e[15;2~
shift-f6   = \e[29~ \e[17;2~
shift-f7   = \e[31~ \e[18;2~
shift-f8   = \e[32~ \e[19;2~
shift-f9   = \e[33~ \e[20;2~
shift-f10  = \e[34~ \e[21;2~
shift-f11  = \e[23;2~
shift-f12  = \e[24;2~
left       = \eOD \e[D \eOt
right      = \eOC \e[C \eOv
up         = \eOA \e[A \eOx
down       = \eOB \e[B \eOr
home       = \eOH \e[H \e[1~ \e[7~ \eOw
end        = \eOF \e[F \e[4~ \e[8~ \eOq
pgup       = \e[5~ \eOy
pgdn       = \e[6~ \eOs
insert     = \e[2~ \eOp
delete     = \e[3~ \eOn
kpmiddle   = \e[E \eOE \eOu
kpslash    = \eOo
kpasterisk = \eOj
kpminus    = \eOm
kpplus     = \eOk
kpenter    = \eOM
backspace  = ^?

# Arrows for both keypad modes (application and normal).
up         = \e[A \eOA
down       = \e[B \eOB
right      = \e[C \eOC
left       = \e[D \eOD

[alacritty]
copy = xterm

[gnome]
copy = xterm

[rxvt]
copy = xterm
# Shift+F1 / Shift+F2 generate the same as F11 / F12 (\e[23~ / \e[24~).
# Prefer to interpret them as Shift+F1 / Shift+F2.
# Actually I have no information whether it's true for old rxvt, but it's
# definitely the case with rxvt-unicode. Assume it's the same for old rxvt.
# Shift_F1 .. Shift+F10 are defined as kf11 .. kf20 in terminfo, rather than
# kf13 .. kf22 as with most terminals, so we need to override to fix them.
shift-f1   = \e[23~
shift-f2   = \e[24~
shift-f3   = \e[25~
shift-f4   = \e[26~
shift-f5   = \e[28~
shift-f6   = \e[29~
shift-f7   = \e[31~
shift-f8   = \e[32~
shift-f9   = \e[33~
shift-f10  = \e[34~
shift-f11  = \e[23$
shift-f12  = \e[24$
ctrl-f1    = \e[11^
ctrl-f2    = \e[12^
ctrl-f3    = \e[13^
ctrl-f4    = \e[14^
ctrl-f5    = \e[15^
ctrl-f6    = \e[17^
ctrl-f7    = \e[18^
ctrl-f8    = \e[19^
ctrl-f9    = \e[20^
ctrl-f10   = \e[21^
ctrl-f11   = \e[23^
ctrl-f11   = \e[24^

[rxvt-unicode]
copy=rxvt

[rxvt-unicode-256color]
copy=rxvt

[putty]
# Same story as with rxvt, except that Shift+F11 / Shift+F12 generate the same
# as their shiftless counterpart, so they won't be recognized.
copy=rxvt

[putty-256color]
copy=rxvt

[xterm-new]
copy = xterm

[xterm-clear]
copy = xterm

[xterm-color]
copy = xterm

[xterm-256color]
copy = xterm

[xterm-direct]
copy = xterm

[xterm-direct16]
copy = xterm

[xterm-direct256]
copy = xterm

[screen]
copy = xterm

[screen-256color]
copy = xterm

[tmux]
copy = xterm

[tmux-256color]
copy = xterm

[ibmpc3]
shift-f1   = \e[Y
shift-f2   = \e[Z
shift-f3   = \e[a
shift-f4   = \e[b
shift-f5   = \e[c
shift-f6   = \e[d
shift-f7   = \e[e
shift-f8   = \e[f
shift-f9   = \e[g
shift-f10  = \e[h
backspace  = ^H
end        = \e[F
kpplus     = \e[+
kpminus    = \e[-
kpasterisk = \e[*

[cons25]
shift-f1   = \e[Y
shift-f2   = \e[Z
shift-f3   = \e[a
shift-f4   = \e[b
shift-f5   = \e[c
shift-f6   = \e[d
shift-f7   = \e[e
shift-f8   = \e[f
shift-f9   = \e[g
shift-f10  = \e[h

[xterm-kitty]
copy = xterm
